# Copier en `.env` a la racine et renseigner. Le .env n'est JAMAIS versionne.
# Une variable deja posee dans le terminal reste prioritaire sur ce fichier.

# --- Choix du moteur (ollama | openai | gemini | api | transformers)
DAMIA_BACKEND=ollama

# --- Connecteur universel OpenAI-compatible (Groq, Mistral, OpenRouter, vLLM...)
# DAMIA_BASE_URL=https://api.groq.com/openai/v1
# DAMIA_API_KEY=votre_cle_ici
# DAMIA_MODELE=openai/gpt-oss-120b

# --- URL du serveur MCP (source unique).
# Local  : http://127.0.0.1:7860/mcp   (defaut, apres `python src/mcp_server.py`)
# Distant: https://<compte>-damia-mcp.hf.space/mcp
# DAMIA_MCP_URL=http://127.0.0.1:7860/mcp

# --- Federation multi-sources (prioritaire sur DAMIA_MCP_URL).
# Format : nom=url, separes par des virgules. Les outils sont alors exposes au
# modele sous un nom qualifie « nom.outil » (ex. damir.query_depenses), ce qui
# rend le routage decidable quand deux sources exposent le meme outil.
# Une source injoignable est signalee et mise de cote ; les autres restent servies.
# DAMIA_MCP_SOURCES=damir=http://127.0.0.1:7860/mcp,medic=http://127.0.0.1:7861/mcp

# Nom donne a la source unique quand DAMIA_MCP_SOURCES n'est pas utilise.
# DAMIA_MCP_SOURCE_DEFAUT=damir

# --- Verification TLS. Ne passer a 0 QUE derriere un proxy d'inspection TLS
#     d'entreprise : a 0, toute interception devient possible.
# MCP_TLS_VERIFY=1
# DAMIA_TLS_VERIFY=1

# --- Niveau de log du serveur MCP (DEBUG | INFO | WARNING | ERROR)
# DAMIA_LOG_LEVEL=INFO
